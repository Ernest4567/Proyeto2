PORT=5000 //el puerto que se ejecuta y usa
DB_HOST=localhost //el host de la base de datos
DB_PORT=5432 //el puerto de la base de datos
DB_USER=postgres //el usuario de la base de datos
DB_PASSWORD=toor //la contraseña de la base de datos
DB_NAME=bookstore //el nombre de la base de datos
JWT_SECRET=your_jwt_secret_KEY //la clave secreta para JWT
JWT_EXPIRES_IN=10h //el tiempo de expiración del token JWT